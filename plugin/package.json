{
  "name": "place-mcp-bridge",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "webpack --config webpack.config.mjs",
    "typecheck": "tsc --noEmit",
