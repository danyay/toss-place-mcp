  },
  "dependencies": {
    "@tossplace/pos-plugin-sdk": "0.0.27"
  },
  "devDependencies": {
    "process": "^0.11.10",
    "ts-loader": "^9.5.4",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
