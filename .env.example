# Required for MCP clients and bridge administration. Generate with:
#   openssl rand -hex 32
TOSS_MCP_ACCESS_TOKEN=replace-with-a-long-random-token

# Local bridge defaults.
TOSS_MCP_HOST=127.0.0.1
TOSS_MCP_PORT=8787
TOSS_MCP_PUBLIC_URL=https://toss-mcp.example.com
TOSS_MCP_DATABASE_URL=sqlite:./data/toss-place.sqlite

# Local stdio MCP client connection.
TOSS_MCP_BRIDGE_URL=http://127.0.0.1:8787

# Optional PostgreSQL alternative:
# TOSS_MCP_DATABASE_URL=postgresql://user:password@postgres:5432/toss_mcp
